# Non-secret example only. Put the replacement key in local .env, never in chat.
# Integration tests read these three local .env settings only after explicit
# opt-in. Offline Agent core never reads this file. Set RUN_AGENT_REAL_LLM_VALIDATION
# in the test process environment; it is intentionally not read from .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
AGENT_OPENAI_MODEL=deepseek-flash
RUN_AGENT_REAL_LLM_VALIDATION=1

# Typesafe Jev judge backend (judge layer, JUDGE-001). The real smoke is the
# integration-marked tests/test_jev_smoke.py; the offline core never reads this file.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# Optional: DeepSeek JSON fallback judge model override (OpenAIJsonJudgeBackend)
JUDGE_OPENAI_MODEL=deepseek-chat
